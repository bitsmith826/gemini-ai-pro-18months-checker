# Mode mesin: "FETCH" (Super cepat & ringan via HTTP Request) atau "PUPPETEER" (Browser Automation)
ENGINE="FETCH"

# Cookie login Google (salin dari browser Anda)
GOOGLE_COOKIE=""

# Kata kunci yang dicari untuk mendeteksi link yang sudah terpakai
TARGET_KEYWORDS="Langganan sudah digunakan, Link langganan ini sudah digunakan, sudah digunakan"

# Mode pencocokan: "ANY" atau "ALL"
MATCH_MODE="ANY"

# Case-sensitive: true atau false
CASE_SENSITIVE=false

# Headless mode (khusus mode PUPPETEER)
HEADLESS=true

# Timeout per halaman (ms)
TIMEOUT_MS=30000

# Jeda antar link (ms)
DELAY_MS=1000

# File daftar link
LINKS_FILE="links.txt"

# Simpan screenshot jika ditemukan (khusus mode PUPPETEER)
SAVE_SCREENSHOT_ON_FOUND=false
